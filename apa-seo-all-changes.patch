diff --git a/scripts/audit-seo.py b/scripts/audit-seo.py
new file mode 100644
--- /dev/null
+++ b/scripts/audit-seo.py
@@ -0,0 +58 @@
+"""Read-only SEO audit. Counts failing PAGES, checks title/description uniqueness.
+SEO problems and info-only checks (viewport, GA4) are reported separately."""
+from collections import Counter, defaultdict
+ROOT = Path(__file__).resolve().parent.parent
+SKIP = {"google99305cdd54a8d1be.html"}
+
+class A(HTMLParser):
+    def __init__(s):
+        super().__init__(); s.titles=[]; s.desc=[]; s.canon=[]; s.h1=0; s.lang=None; s.vp=0; s.noindex=False; s._t=None
+    def handle_starttag(s, tag, a):
+        a = dict(a)
+        if tag == "html": s.lang = a.get("lang")
+        elif tag == "title": s._t = ""
+        elif tag == "h1": s.h1 += 1
+        elif tag == "meta":
+            n = a.get("name", "").lower()
+            if n == "description": s.desc.append(a.get("content", ""))
+            if n == "viewport": s.vp += 1
+            if n == "robots" and "noindex" in a.get("content", "").lower(): s.noindex = True
+        elif tag == "link" and a.get("rel", "").lower() == "canonical": s.canon.append(a.get("href", ""))
+    def handle_data(s, d):
+        if s._t is not None: s._t += d
+    def handle_endtag(s, tag):
+        if tag == "title" and s._t is not None: s.titles.append(s._t.strip()); s._t = None
+
+    pages = {}
+    for p in sorted(ROOT.rglob("*.html")):
+        if {".git", ".github"} & set(p.parts) or p.name in SKIP: continue
+        txt = p.read_text(encoding="utf-8", errors="ignore"); a = A(); a.feed(txt)
+        if a.noindex: continue
+        pages[str(p.relative_to(ROOT))] = (a, "G-41Q0QR6ZHD" in txt)
+    tc = Counter(a.titles[0] for a, _ in pages.values() if a.titles)
+    dc = Counter(a.desc[0] for a, _ in pages.values() if a.desc)
+    seo = defaultdict(list); info = defaultdict(list)
+    for rel, (a, ga) in pages.items():
+        c = a.canon
+        if not (len(c) == 1 and c[0].startswith("https://") and "?" not in c[0] and not c[0].endswith("/index.html")): seo["canonical"].append(rel)
+        if len(a.titles) != 1 or not a.titles[0]: seo["title missing"].append(rel)
+        elif len(a.titles[0]) >= 60: seo["title too long (60+)"].append(rel)
+        elif tc[a.titles[0]] > 1: seo["title duplicate"].append(rel)
+        if len(a.desc) != 1 or not a.desc[0]: seo["description missing"].append(rel)
+        elif len(a.desc[0]) >= 160: seo["description too long (160+)"].append(rel)
+        elif dc[a.desc[0]] > 1: seo["description duplicate"].append(rel)
+        if a.h1 != 1: seo["not exactly one H1"].append(rel)
+        if a.lang != "en-AU": seo['lang not en-AU'].append(rel)
+        if a.vp != 1: info["viewport"].append(rel)
+        if not ga: info["GA4 missing"].append(rel)
+    bad = {r for v in seo.values() for r in v}
+    print(f"Indexable pages audited: {len(pages)}")
+    print(f"Pages with at least one SEO problem: {len(bad)}")
+    for k, v in sorted(seo.items(), key=lambda x: -len(x[1])):
+        folders = Counter(r.split("/")[0] if "/" in r else "root" for r in v)
+        print(f"  {k}: {len(v)} pages  {dict(folders)}")
+    print("Info only (not SEO failures):", {k: len(v) for k, v in info.items()} or "none")
+    if "-v" in __import__("sys").argv:
+        for k, v in seo.items():
+            print(f"\n[{k}]"); print("\n".join(v[:40]))
+main()
